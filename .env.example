# --- Required ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Thresholds (defaults shown) ---
MIN_TRADE_USDC=1000
WHALE_NOTIONAL_USDC=10000
LIQUIDITY_IMPACT_PCT=0.02
FRESH_WALLET_MAX_TX=5
SNIPER_WINDOW_MIN=10
PRE_RESOLUTION_WINDOW_HOURS=6
PRE_RESOLUTION_MIN_USDC=5000
PRE_RESOLUTION_PRICE_EDGE=0.3
COMPOSITE_THRESHOLD=40
DEDUPE_WINDOW_MIN=30

# --- Storage ---
DB_PATH=data/tikitaka.db
PARQUET_DIR=data/trades

# --- Ingest ---
GAMMA_POLL_SECONDS=60
WEBSOCKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
MAX_ASSETS_PER_SOCKET=500
